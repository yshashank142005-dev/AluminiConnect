# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/alumniconnect

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# OpenAI (optional - app works without it using mock responses)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Resend — OTP email verification (HTTPS API, works on Render/cloud)
# Sign up free at https://resend.com → API Keys → Create API Key
# Free tier: 3,000 emails/month
RESEND_API_KEY=re_your_api_key_here

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
