# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/alumniconnect

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# OpenAI (optional - app works without it using mock responses)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Gmail SMTP — OTP email verification
# Use your Gmail address + a Google App Password (NOT your real password)
# Enable 2FA first, then generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
